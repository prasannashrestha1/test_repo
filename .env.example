# Copy this file to .env and paste in the real Bubble API token.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed, pasted into Slack/tickets,
# or shared outside the machine it runs on.
#
# This file is only for LOCAL development. A cloud routine or CI job should
# instead inject BUBBLE_API_TOKEN as an environment variable / secret — a real
# environment variable always takes precedence over this file, so no .env needs
# to exist there at all.
#
# Format: plain KEY=value, no `export` prefix, no surrounding quotes.
# Use --env-file to point at a different file than .env.
BUBBLE_API_TOKEN=your-bubble-api-token-here
