[Unit]
Description=Quiet List Exchange Activity Report generator
Documentation=file:///opt/quietlist-reports/DEPLOYMENT.md
# Bubble's Data API must be reachable before this runs.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quietlist
Group=quietlist
WorkingDirectory=/opt/quietlist-reports

# Supplies BUBBLE_API_TOKEN. generate_report.py also loads .env itself via
# python-dotenv, so this is belt-and-braces — either path works, and neither
# puts the token on the command line where `ps` could see it.
EnvironmentFile=/opt/quietlist-reports/.env

ExecStart=/opt/quietlist-reports/venv/bin/python run_scheduled_report.py

# Everything the script prints goes to the journal (journalctl -u quietlist-report).
StandardOutput=journal
StandardError=journal

# The report is not urgent; never let it starve the box of I/O or CPU.
Nice=10
IOSchedulingClass=idle

# Basic hardening — this only needs to read the app dir and write ./reports.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/quietlist-reports/reports /opt/quietlist-reports/logs
