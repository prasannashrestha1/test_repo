[Unit]
Description=Run the Quiet List report generator on the 1st and 15th

[Timer]
# Fires 06:00 on the 1st and 15th of every month. compute_period.py re-checks
# this independently and exits 0 on any other day, so a manual/misfired run
# still can't produce an off-cycle report.
OnCalendar=*-*-01,15 06:00:00

# If the VPS was powered off (or rebooting) at 06:00, run as soon as it's
# back rather than silently skipping the cycle.
Persistent=true

# Avoid every deployment hitting Bubble at the same instant.
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
